# Copie este arquivo para .env e ajuste conforme necessário.
# NUNCA versione o arquivo .env.

# Banco de dados (SQLite por padrão; formato de URL SQLAlchemy)
LEGAL_MONITOR_DATABASE_URL=sqlite:///data/legal_monitor.db

# Nome exibido como autor das operações no histórico (MVP sem autenticação)
LEGAL_MONITOR_USER=Operador local

# Carrega dados demonstrativos automaticamente quando o banco estiver vazio
LEGAL_MONITOR_AUTO_SEED_DEMO=true

# Antecedência (em dias) para destacar possíveis prazos próximos
LEGAL_MONITOR_DEADLINE_ALERT_DAYS=7

# --- Integrações futuras (ainda NÃO implementadas no MVP 1.0) ---
